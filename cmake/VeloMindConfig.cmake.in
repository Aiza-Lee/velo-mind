@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(VELOMIND_VERSION "@PROJECT_VERSION@")
set(VELOMIND_ENABLE_CUDA "@VELOMIND_ENABLE_CUDA@")
set(VELOMIND_ENABLE_ISPC "@VELOMIND_ENABLE_ISPC@")
set(VELOMIND_ENABLE_VULKAN "@VELOMIND_ENABLE_VULKAN@")

if(VELOMIND_ENABLE_CUDA)
    find_dependency(CUDAToolkit)
endif()

if(VELOMIND_ENABLE_VULKAN)
    find_dependency(Vulkan)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VeloMindTargets.cmake")
check_required_components(VeloMind)
